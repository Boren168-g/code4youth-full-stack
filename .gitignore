# ---------------------------------------------------------------- secrets --
# Committing any of these is the one mistake you cannot undo — a leaked
# service account key gives full admin access to the Firebase project, and
# git history keeps it even after you delete the file.
infra/.env
api/.env
api/storage/app/firebase/
app/android/app/google-services.json
app/ios/Runner/GoogleService-Info.plist
app/lib/firebase_options.dart

# ------------------------------------------------------------------ infra --
infra/storage/

# ---------------------------------------------------------------- laravel --
api/vendor/
api/node_modules/
api/public/build/
api/public/hot
api/public/storage
api/storage/*.key
api/storage/pail
api/storage/logs/*.log
api/storage/framework/cache/data/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/bootstrap/cache/*.php
api/.phpunit.result.cache
api/.phpunit.cache/

# ---------------------------------------------------------------- flutter --
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/android/**/*.keystore
app/android/**/*.jks
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/ephemeral/

# ------------------------------------------------------------------- misc --
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json