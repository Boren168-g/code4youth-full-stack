[mysqld]
# utf8mb4 end to end, so emoji in lesson content and usernames survive.
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# Containers have no reverse DNS; skipping lookups removes a multi-second
# stall on the first connection from each new container IP.
skip-name-resolve

max_connections         = 100
innodb_buffer_pool_size = 256M
innodb_flush_log_at_trx_commit = 2

# Laravel migrations create fairly long index names.
innodb_file_per_table = 1

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
