# Copy this file to infra/.env. Never commit infra/.env.
# compose.dev.yml uses the local values; compose.yml uses the deployment values.

# --- Host ports --------------------------------------------------------------
APP_PORT=8000
PMA_PORT=8080
DB_PORT_HOST=3309

# --- Application --------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DOMAIN=api.example.com
# Required by compose.yml. Generate with: php artisan key:generate --show
APP_KEY=base64:REPLACE_WITH_A_REAL_LARAVEL_KEY
IMAGE_NAME=code4youth
IMAGE_TAG=production

# --- Database ----------------------------------------------------------------
DB_DATABASE=code4youth
DB_USERNAME=code4youth
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_ROOT_PASSWORD

# --- Firebase ----------------------------------------------------------------
# The service account JSON itself lives at
#   api/storage/app/firebase/service-account.json
# and must never be committed.
FIREBASE_PROJECT_ID=code4youth-xxxxx
